#!/bin/bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/yahr-ipc" ]; then
    exec "$DIR/yahr-ipc" toggleCalendar
fi
if [ -x "$HOME/.config/quickshell/scripts/yahr-ipc" ]; then
    exec "$HOME/.config/quickshell/scripts/yahr-ipc" toggleCalendar
fi
# Legacy dev-tree fallback
if [ -x "$HOME/Projects/yahr-shell/quickshell/scripts/yahr-ipc" ]; then
    exec "$HOME/Projects/yahr-shell/quickshell/scripts/yahr-ipc" toggleCalendar
fi
echo "yahr-ipc not found" >&2
exit 1
